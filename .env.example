# ---------------------------------------------------------------------------
# FlowPilot — environment template. Copy to `.env` and fill in.
# Never commit a real .env file.
# ---------------------------------------------------------------------------

# PostgreSQL connection string. The docker-compose file in this repo starts a
# matching database with pgvector preinstalled.
DATABASE_URL="postgresql://flowpilot:flowpilot@localhost:5432/flowpilot?schema=public"

# Session signing secret for Auth.js. Generate one with: openssl rand -base64 32
AUTH_SECRET="replace-me-with-a-long-random-string"

# --- AI provider ------------------------------------------------------------
# "mock"   — deterministic offline provider. No API key needed. Default.
# "openai" — any OpenAI-compatible chat-completions + embeddings endpoint.
AI_PROVIDER="mock"

# Required only when AI_PROVIDER=openai. Without it the app falls back to mock.
LLM_API_KEY=""
LLM_BASE_URL="https://api.openai.com/v1"
LLM_MODEL="gpt-4o-mini"
EMBEDDING_MODEL="text-embedding-3-small"

# --- Retrieval --------------------------------------------------------------
# "auto"     — use pgvector when the extension is installed, else the portable
#              in-application cosine scan. Recommended.
# "pgvector" — force pgvector.
# "fallback" — force the portable store (useful on managed Postgres without
#              the extension).
VECTOR_STORE="auto"

# --- Email ------------------------------------------------------------------
# "mock"   — messages are stored and shown in the in-app sent-mail view only.
# "resend" — deliver through Resend (requires RESEND_API_KEY).
EMAIL_PROVIDER="mock"
RESEND_API_KEY=""
EMAIL_FROM="ops@flowpilot.demo"

# --- Demo -------------------------------------------------------------------
# Shows the demo account picker on the sign-in page. Set to false for anything
# resembling a real deployment.
DEMO_MODE="true"
